{
  "name": "webgis-jabodetabek-layout-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/serve-layout.mjs",
    "build:ui": "node tools/build-tabler-css.mjs",
    "capture:layout": "node tools/capture-layout.mjs",
    "capture:lrt": "node tools/capture-lrt-mobile.mjs",
    "capture:mobile-ux": "node tools/capture-mobile-ux.mjs",
    "test:layout": "node --test --test-reporter=tap --test-concurrency=1 tools/test-layout-*.mjs tools/test-font-pt-sans.mjs tools/test-lrt-popup.mjs",
    "test:lrt": "node --test --test-reporter=tap tools/test-lrt-popup.mjs",
    "test:a01": "node --test --test-reporter=tap tools/test-a01-toggle.mjs",
    "test:regression": "npm run test:layout && npm run test:a01"
  },
  "devDependencies": {
    "@tabler/core": "1.4.0",
    "leaflet": "1.9.4",
    "playwright": "1.57.0",
    "postcss": "8.5.6",
    "sass": "1.93.2"
  }
}
